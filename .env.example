# API Keys for AI Models
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Google Credentials (optional for Gemini)
GOOGLE_CREDENTIALS_PATH=/app/credentials.json

# Ollama Configuration (optional for Granite)
# For Docker: use host.docker.internal instead of localhost
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# For local development:
# OLLAMA_BASE_URL=http://localhost:11434

# Disable CrewAI Telemetry (recommended for Docker)
OTEL_SDK_DISABLED=true

# Streamlit Configuration (optional - loaded from .streamlit/config.toml)
STREAMLIT_SERVER_PORT=8577
STREAMLIT_SERVER_ADDRESS=0.0.0.0
